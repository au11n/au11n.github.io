{{- $pages := where .Site.RegularPages "Section" "ne" "" -}}
[{{ range $i, $p := $pages }}{{ if $i }},{{ end }}
  {
    "title": {{ $p.Title | jsonify }},
    "url": {{ $p.RelPermalink | jsonify }},
    "date": "{{ $p.Date.Format "Jan 2, 2006" }}",
    "tags": [{{ range $j, $t := $p.Params.tags }}{{ if $j }},{{ end }}{{ $t | jsonify }}{{ end }}],
    "content": {{ $p.Plain | jsonify }}
  }
{{- end }}
]
